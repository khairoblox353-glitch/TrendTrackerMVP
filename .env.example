# ---- Database ---------------------------------------------------------------
POSTGRES_USER=trend
POSTGRES_PASSWORD=trend
POSTGRES_DB=trend_tracker
POSTGRES_PORT=5432

# SQLAlchemy URL used by the backend. Inside Docker Compose the host is `db`;
# when running the backend directly on your machine, use `localhost`.
DATABASE_URL=postgresql+psycopg://trend:trend@db:5432/trend_tracker
SQL_ECHO=false

# ---- App -------------------------------------------------------------------
APP_NAME=Trend Tracker API
APP_DEBUG=false
CORS_ORIGINS=http://localhost:3000

# ---- Frontend --------------------------------------------------------------
# Address the Next.js server uses to reach FastAPI.
# Docker Compose: http://backend:8000 | local dev: http://localhost:8000
API_BASE_URL=http://backend:8000
FRONTEND_PORT=3000

# ---- Trend algorithm (spec 9, spec 10) -------------------------------------
TREND_WINDOW_DAYS=7
TREND_HISTORY_DAYS=30
WEIGHT_GROWTH=0.7
WEIGHT_VOLUME=0.3
EMERGING_GROWTH_CAP=3.0
# Lower bound a topic's growth rate may fall to; clamped so one collapse cannot
# dominate the weighted score.
GROWTH_FLOOR=-1.0
GROWTH_SATURATION=1.0
GROWING_THRESHOLD=0.20
DECLINING_THRESHOLD=-0.20

# ---- Classification (spec 8) -----------------------------------------------
CLASSIFICATION_MIN_CONFIDENCE=0.55
FALLBACK_TOPIC_NAME=Other

# ---- LLM (optional; leave disabled to use the offline keyword classifier) ---
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# ---- Collector (spec 15) ---------------------------------------------------
COLLECTOR_TIMEOUT_SECONDS=15
COLLECTOR_MAX_ARTICLES_PER_SOURCE=50
COLLECTOR_USER_AGENT=TrendTrackerBot/0.1 (+https://example.com/bot)

# ---- Scheduler (spec 14) ---------------------------------------------------
# Enable only when a single backend replica runs, otherwise disable and use cron
# against POST /api/ingestion/run and POST /api/trends/recalculate.
RUN_SCHEDULER=false
INGEST_INTERVAL_MINUTES=60
RECALCULATE_INTERVAL_MINUTES=360
